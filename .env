# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_URL=https://localhost:8443
APP_SECRET=change-me-in-env-local
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# The "database" hostname is the compose service. It does not resolve from the
# host, so console commands run inside the php container (see README).
DATABASE_URL="postgresql://root:urbankiz@database:5432/urbankiz?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Dev sends to Mailpit (docker-compose.override.yml). Prod sets a real DSN.
MAILER_DSN=smtp://mailer:1025
###< symfony/mailer ###

###> cloudflare/turnstile ###
# Cloudflare's published always-pass test keys. They render a widget that
# always succeeds, so the public forms work locally. Replace in production.
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
###< cloudflare/turnstile ###
