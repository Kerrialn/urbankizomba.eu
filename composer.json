{
    "name": "kerrialn/urbankizomba.eu",
    "description": "Community events calendar for the urban kiz scene in Europe.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^3",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.3",
        "easycorp/easyadmin-bundle": "^4.27",
        "knplabs/knp-paginator-bundle": "^6.6",
        "league/commonmark": "^2.10",
        "nesbot/carbon": "^3.8",
        "pentatrion/vite-bundle": "*",
        "symfony/asset": "^7.3",
        "symfony/cache": "^7.3",
        "symfony/cache-contracts": "^3.5",
        "symfony/console": "^7.3",
        "symfony/debug-bundle": "^7.3",
        "symfony/doctrine-messenger": "^7.3",
        "symfony/dotenv": "^7.3",
        "symfony/flex": "^2",
        "symfony/form": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/http-client": "^7.3",
        "symfony/intl": "^7.3",
        "symfony/mailer": "^7.3",
        "symfony/maker-bundle": "^1.61",
        "symfony/mime": "^7.3",
        "symfony/monolog-bundle": "^3.0",
        "symfony/polyfill-intl-messageformatter": "^1.31",
        "symfony/process": "^7.3",
        "symfony/property-access": "^7.3",
        "symfony/property-info": "^7.3",
        "symfony/rate-limiter": "^7.3",
        "symfony/runtime": "^7.3",
        "symfony/scheduler": "^7.3",
        "symfony/security-bundle": "^7.3",
        "symfony/serializer": "^7.3",
        "symfony/stimulus-bundle": "^2.20",
        "symfony/string": "^7.3",
        "symfony/translation": "^7.3",
        "symfony/twig-bundle": "^7.3",
        "symfony/uid": "^7.3",
        "symfony/ux-icons": "^2.2",
        "symfony/ux-toolkit": "^2.36.1",
        "symfony/ux-turbo": "^2.20",
        "symfony/validator": "^7.3",
        "symfony/yaml": "^7.3",
        "tales-from-a-dev/twig-tailwind-extra": "*",
        "twig/extra-bundle": "^3.0",
        "twig/intl-extra": "^3.13",
        "twig/twig": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "test": "XDEBUG_MODE=off vendor/bin/phpunit",
        "fix-cs": "vendor/bin/ecs check --fix --ansi",
        "check-cs": "vendor/bin/ecs check --ansi",
        "phpstan": "php -d memory_limit=1G vendor/bin/phpstan analyze",
        "rector-dry": "vendor/bin/rector p --dry-run --ansi",
        "rector": "vendor/bin/rector p --ansi",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.3"
        }
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.6",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-doctrine": "^1.5",
        "phpunit/phpunit": "^9.5",
        "rector/rector": "^1.2",
        "symfony/browser-kit": "^7.3",
        "symfony/css-selector": "^7.3",
        "symfony/phpunit-bridge": "^7.1",
        "symfony/stopwatch": "^7.3",
        "symfony/web-profiler-bundle": "^7.3",
        "symplify/easy-coding-standard": "^12.3"
    }
}
