{% extends 'base.html.twig' %}

{% block title %}{{ 'account.title'|trans }} · {{ site.name }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    <div class="mx-auto max-w-4xl px-4 py-10">
        <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold tracking-tight text-heading">{{ 'account.title'|trans }}</h1>
                <p class="mt-2 text-sm text-body-subtle">{{ app.user.email }}</p>
            </div>
            <a href="{{ path('app_submit') }}"
               class="facet-sm bg-primary px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-hover">
                {{ 'nav.submit'|trans }}
            </a>
        </div>

        <section class="mt-10">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-body-subtle">{{ 'account.events.heading'|trans }}</h2>

            {% if events is empty %}
                <div class="mt-4 facet facet-frame facet-line-default-medium facet-fill-brand-softer p-8 text-center">
                    <p class="font-medium text-heading">{{ 'account.events.empty.title'|trans }}</p>
                    <p class="mt-2 text-sm text-body-subtle">{{ 'account.events.empty.body'|trans }}</p>
                </div>
            {% else %}
                <ul class="facet-vary mt-4 space-y-3">
                    {% for event in events %}
                        <li class="facet facet-frame p-5">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <a href="{{ path('app_event', { slug: event.slug }) }}" class="font-semibold text-heading hover:text-primary hover:underline">{{ event.title }}</a>
                                    <p class="mt-1 text-sm text-body-subtle">
                                        {{ event.type.label|trans }} · {{ event.city.name }}
                                        {% if event.startsAt %} · {{ event.startsAt|format_date('medium') }}{% elseif event.schedule %} · {{ event.schedule }}{% endif %}
                                    </p>
                                </div>
                                <span class="facet-sm px-2.5 py-0.5 text-xs font-medium
                                    {{ event.approved ? 'bg-success-medium text-success-strong'
                                     : event.pending ? 'bg-warning-medium text-warning-strong'
                                     : 'bg-danger-medium text-danger-strong' }}">
                                    {{ event.status.label|trans }}
                                </span>
                            </div>

                            {% if event.reviewNote and not event.pending %}
                                <p class="mt-3 facet-sm bg-neutral-secondary-soft px-3 py-2 text-sm text-body">{{ 'account.events.note'|trans({ note: event.reviewNote }) }}</p>
                            {% endif %}

                            <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
                                <a href="{{ path('app_account_event_edit', { id: event.id }) }}" class="font-medium text-primary hover:underline">{{ 'account.events.edit'|trans }}</a>
                                {% if event.recurring and event.approved %}
                                    <form method="post" action="{{ path('app_account_event_confirm', { id: event.id }) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('confirm-' ~ event.id) }}">
                                        <button type="submit" class="font-medium {{ event.isStale(confirmation_days) ? 'text-warning' : 'text-body-subtle' }} hover:underline">
                                            {{ 'account.events.confirm'|trans }}
                                        </button>
                                    </form>
                                    <span class="text-xs text-body-subtle">
                                        {% if event.lastConfirmedAt %}{{ 'social.last_confirmed'|trans({ date: event.lastConfirmedAt|format_date('medium') }) }}{% endif %}
                                    </span>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
{% endblock %}
