{% extends 'base.html.twig' %}

{% block title %}{{ 'home.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'home.meta_description'|trans }}{% endblock %}

{# The site as an entity, stated once on the home page. #}
{% block structured_data %}
    <script type="application/ld+json">
        {{ {
            '@context': 'https://schema.org',
            '@type': 'WebSite',
            'name': site.name,
            'url': url('app_home'),
            'description': 'home.meta_description'|trans,
            'inLanguage': app.request.locale,
        }|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}
    </script>
{% endblock %}

{% block body %}
    {# Full-viewport hero. The video is decoration: muted, looping, no
       controls, hidden for anyone who asked for reduced motion (app.css). The
       poster is what shows first, on slow connections, and when there is no
       clip yet. Everything a visitor needs is in the text on top of it. #}
    <section class="relative flex min-h-[85vh] items-end overflow-hidden bg-brand-strong text-white">
        {% if hero_video %}
            <video class="hero-video absolute inset-0 h-full w-full object-cover"
                   autoplay muted loop playsinline preload="metadata"
                   poster="{{ asset(hero.poster) }}"
                   aria-hidden="true">
                <source src="{{ asset(hero.video) }}" type="video/mp4">
            </video>
        {% else %}
            <img src="{{ asset(hero.poster) }}" alt="" aria-hidden="true"
                 class="absolute inset-0 h-full w-full object-cover">
        {% endif %}

        {# Darkening from the bottom, where the text sits, so white copy holds
           contrast on any frame of the clip. #}
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/20" aria-hidden="true"></div>

        <div class="relative mx-auto w-full max-w-7xl px-4 pb-16 pt-32 sm:pb-24">
            <div class="max-w-2xl">
                <p class="text-sm font-semibold uppercase tracking-widest text-brand-medium">{{ 'home.kicker'|trans }}</p>
                <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-6xl">
                    {{ 'home.heading'|trans }}
                </h1>
                <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/85">{{ 'home.intro'|trans }}</p>
                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <a href="{{ path('app_events') }}"
                       class="rounded-base bg-white px-5 py-3 text-center font-medium text-brand-strong hover:bg-brand-softer">
                        {{ 'home.cta.events'|trans }}
                    </a>
                    <a href="{{ path('app_submit') }}"
                       class="rounded-base border border-white/40 px-5 py-3 text-center font-medium text-white hover:bg-white/10">
                        {{ 'home.cta.submit'|trans }}
                    </a>
                </div>
                <p class="mt-6 text-sm text-white/70">
                    {{ 'home.new_here'|trans }}
                    <a href="{{ path('app_article', { slug: 'what-is-urban-kiz' }) }}" class="font-medium text-white underline decoration-white/50 underline-offset-4 hover:decoration-white">{{ 'home.new_here_link'|trans }}</a>
                </p>
            </div>

            {# Whoever filmed it is named on the frame, every time. #}
            {% if hero_video and hero.credit_name %}
                <p class="mt-8 text-xs text-white/60 sm:absolute sm:bottom-6 sm:right-4 sm:mt-0">
                    {{ 'home.footage_credit'|trans }}
                    {% if hero.credit_url %}
                        <a href="{{ hero.credit_url }}" rel="noopener" target="_blank" class="underline decoration-white/40 underline-offset-2 hover:text-white">{{ hero.credit_name }}</a>
                    {% else %}
                        {{ hero.credit_name }}
                    {% endif %}
                </p>
            {% endif %}
        </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-12">
        <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl font-bold text-heading">{{ 'home.upcoming.heading'|trans }}</h2>
            <a href="{{ path('app_events') }}" class="text-sm font-medium text-primary hover:underline">{{ 'home.upcoming.all'|trans }}</a>
        </div>

        {% if events is empty %}
            <div class="mt-6 rounded-2xl border border-dashed border-default-medium bg-white p-8 text-center">
                <p class="font-medium text-heading">{{ 'home.upcoming.empty.title'|trans }}</p>
                <p class="mt-2 text-sm text-body-subtle">{{ 'home.upcoming.empty.body'|trans }}</p>
                <a href="{{ path('app_submit') }}" class="mt-4 inline-block text-sm font-medium text-primary hover:underline">{{ 'home.cta.submit'|trans }}</a>
            </div>
        {% else %}
            <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                {% for event in events %}
                    {{ include('event/_card.html.twig', { event: event }) }}
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {% if cities is not empty %}
        <section class="mx-auto max-w-7xl px-4 py-8">
            <div class="flex items-baseline justify-between gap-4">
                <h2 class="text-2xl font-bold text-heading">{{ 'home.cities.heading'|trans }}</h2>
                <a href="{{ path('app_cities') }}" class="text-sm font-medium text-primary hover:underline">{{ 'home.cities.all'|trans }}</a>
            </div>
            <ul class="mt-6 flex flex-wrap gap-2">
                {% for row in cities %}
                    <li>
                        <a href="{{ path('app_city', { slug: row.city.slug }) }}"
                           class="inline-flex items-center gap-2 rounded-full border border-default bg-white px-4 py-2 text-sm font-medium text-body hover:border-brand hover:text-primary">
                            {{ row.city.name }}
                            <span class="text-xs text-body-subtle">{{ row.upcoming + row.socials }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <section class="mx-auto max-w-7xl px-4 py-12">
        {{ include('newsletter/_block.html.twig', { form: newsletter_form }) }}
    </section>
{% endblock %}
