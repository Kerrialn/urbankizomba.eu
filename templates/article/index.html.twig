{% extends 'base.html.twig' %}

{% block title %}{{ 'articles.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'articles.meta_description'|trans }}{% endblock %}

{# An index with nothing on it is a page a crawler should not keep. It is left
   reachable, so a visitor who guesses the URL gets an explanation rather than
   a 404. #}
{% block robots %}
    {% if articles is empty %}
        <meta name="robots" content="noindex, follow">
    {% endif %}
{% endblock %}

{% block body %}
    <div class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
        <h1 class="text-3xl font-bold tracking-tight text-heading">{{ 'articles.title'|trans }}</h1>
        <p class="mt-3 text-lg text-body">{{ 'articles.intro'|trans }}</p>

        {% if articles is empty %}
            <p class="mt-10 rounded-2xl border border-default bg-neutral-secondary-soft p-5 text-sm text-body-subtle">
                {{ 'articles.empty'|trans }}
            </p>
        {% else %}
            <div class="mt-10 divide-y divide-default overflow-hidden rounded-2xl border border-default bg-white">
                {% for article in articles %}
                    <a href="{{ path('app_article', { slug: article.slug }) }}"
                       class="block p-5 hover:bg-neutral-secondary-soft">
                        {% if article.category %}
                            <p class="text-sm font-medium text-primary">{{ article.category }}</p>
                        {% endif %}
                        <h2 class="mt-1 font-semibold text-heading">{{ article.heading }}</h2>
                        <p class="mt-2 text-sm text-body">{{ article.metaDescription }}</p>
                        <p class="mt-3 text-xs text-body-subtle">
                            <time datetime="{{ article.updated|date('Y-m-d') }}">{{ article.updated|format_date('long') }}</time>
                            {% if article.readingMinutes %}
                                · {{ 'articles.reading'|trans({ count: article.readingMinutes }) }}
                            {% endif %}
                        </p>
                    </a>
                {% endfor %}
            </div>
        {% endif %}

        <aside class="mt-10 rounded-2xl border border-default bg-neutral-secondary-soft p-6 text-center">
            <p class="font-semibold text-heading">{{ 'articles.cta.heading'|trans }}</p>
            <div class="mt-5 flex flex-col justify-center gap-3 sm:flex-row">
                <a href="{{ path('app_events') }}"
                   class="rounded-base bg-primary px-5 py-3 font-medium text-white hover:bg-primary-hover">
                    {{ 'articles.cta.events'|trans }}
                </a>
                <a href="{{ path('app_submit') }}"
                   class="rounded-base border border-default bg-white px-5 py-3 font-medium text-body hover:bg-neutral-secondary-medium">
                    {{ 'articles.cta.submit'|trans }}
                </a>
            </div>
            <p class="mt-4 text-sm text-body-subtle">{{ 'articles.cta.note'|trans }}</p>
        </aside>
    </div>
{% endblock %}
