{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}
{% block meta_description %}{{ article.metaDescription }}{% endblock %}
{% block og_type %}article{% endblock %}

{% block og_meta %}
    <meta property="article:published_time" content="{{ article.published|date('Y-m-d') }}">
    <meta property="article:modified_time" content="{{ article.updated|date('Y-m-d') }}">
    {% if article.category %}
        <meta property="article:section" content="{{ article.category }}">
    {% endif %}
    {% for keyword in article.keywords %}
        <meta property="article:tag" content="{{ keyword }}">
    {% endfor %}
{% endblock %}

{# The block is declared unconditionally — Twig will not have one inside an if —
   and falls back to the site-wide card where the article names no image. #}
{% block og_image %}
    {% if article.ogImage %}
        {% set article_image = absolute_url(asset(article.ogImage|trim('/'))) %}
        <meta property="og:image" content="{{ article_image }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="{{ article.heading }}">
        <meta name="twitter:image" content="{{ article_image }}">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{# Article and, where the text answers questions, FAQPage. Assembled in PHP and
   printed here: a graph of nested objects written as Twig hashes stops being
   readable at the second level. #}
{% block structured_data %}
    <script type="application/ld+json">
        {{ article.jsonLd(
            url('app_article', { slug: article.slug }),
            company,
            absolute_url(asset('images/logo-180.png'))
        )|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}
    </script>
{% endblock %}

{% block body %}
    <article class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
        <nav class="text-sm">
            <a href="{{ path('app_articles') }}" class="text-primary hover:underline">
                &larr; {{ 'articles.all'|trans }}
            </a>
        </nav>

        <header class="mt-6">
            {% if article.category %}
                <p class="text-sm font-medium text-primary">{{ article.category }}</p>
            {% endif %}
            <h1 class="mt-2 text-3xl font-bold tracking-tight text-heading">{{ article.heading }}</h1>
            <p class="mt-3 text-sm text-body-subtle">
                <time datetime="{{ article.updated|date('Y-m-d') }}">{{ article.updated|format_date('long') }}</time>
                {% if article.readingMinutes %}
                    · {{ 'articles.reading'|trans({ count: article.readingMinutes }) }}
                {% endif %}
            </p>
        </header>

        {# The same prose styling as the legal documents, for the same reason:
           one place to change, and no wall of utility classes on every
           paragraph of Markdown we did not write by hand. #}
        <div class="mt-10 space-y-6 text-body
                    [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-heading
                    [&_h3]:mt-6 [&_h3]:font-semibold [&_h3]:text-heading
                    [&_p]:leading-relaxed
                    [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-6
                    [&_ol]:list-decimal [&_ol]:space-y-1.5 [&_ol]:pl-6
                    [&_a]:text-primary [&_a]:underline
                    [&_strong]:font-semibold [&_strong]:text-heading
                    [&_hr]:border-default
                    [&_blockquote]:rounded-base [&_blockquote]:bg-neutral-secondary-soft [&_blockquote]:p-4 [&_blockquote]:text-sm
                    [&_blockquote>p]:m-0
                    [&_table]:w-full [&_table]:text-sm
                    [&_th]:border-b [&_th]:border-default [&_th]:py-2 [&_th]:text-left [&_th]:font-medium
                    [&_td]:border-b [&_td]:border-light [&_td]:py-2 [&_td]:align-top [&_td]:pr-4">
            {# A wide table has to scroll inside itself; the page must not. #}
            <div class="overflow-x-auto">{{ article.html|raw }}</div>
        </div>

        {% if article.cta.primary is defined %}
            <aside class="mt-12 rounded-2xl border border-default bg-neutral-secondary-soft p-6 text-center">
                <p class="font-semibold text-heading">{{ 'articles.cta.heading'|trans }}</p>
                <div class="mt-5 flex flex-col justify-center gap-3 sm:flex-row">
                    <a href="{{ path(article.cta.primary.route) }}"
                       class="rounded-base bg-primary px-5 py-3 font-medium text-white hover:bg-primary-hover">
                        {{ article.cta.primary.label }}
                    </a>
                    {% if article.cta.secondary is defined %}
                        <a href="{{ path(article.cta.secondary.route) }}"
                           class="rounded-base border border-default bg-white px-5 py-3 font-medium text-body hover:bg-neutral-secondary-medium">
                            {{ article.cta.secondary.label }}
                        </a>
                    {% endif %}
                </div>
                <p class="mt-4 text-sm text-body-subtle">{{ 'articles.cta.note'|trans }}</p>
            </aside>
        {% endif %}

        {% if more %}
            <section class="mt-12 border-t border-default pt-8">
                <h2 class="font-semibold text-heading">{{ 'articles.more'|trans }}</h2>
                <ul class="mt-4 space-y-3">
                    {% for other in more %}
                        <li>
                            <a href="{{ path('app_article', { slug: other.slug }) }}"
                               class="text-primary hover:underline">{{ other.heading }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </article>
{% endblock %}
