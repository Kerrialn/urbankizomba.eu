{% set nav_link_class = 'block rounded-base px-3 py-2 text-sm font-medium text-body hover:bg-neutral-secondary-medium md:py-1.5' %}
{% set nav_cta_class = 'block rounded-base bg-primary px-3 py-2 text-center text-sm font-medium text-white hover:bg-primary-hover md:py-1.5' %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# Captured rather than printed straight into the tags: the same two strings
       have to reach <title>, og: and twitter:, and a page that overrides the
       block should not have to override them three more times. #}
    {% set meta_title %}{% block title %}{{ site.name }}{% endblock %}{% endset %}
    {% set meta_desc %}{% block meta_description %}{{ 'meta.default_description'|trans }}{% endblock %}{% endset %}
    {% set meta_title = meta_title|trim %}
    {% set meta_desc = meta_desc|trim %}

    <title>{{ meta_title }}</title>
    <meta name="description" content="{{ meta_desc }}">
    {% block robots %}{% endblock %}
    <link rel="icon" href="{{ asset('images/logo-64.png') }}" sizes="any">
    <link rel="icon" href="{{ asset('images/logo.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ asset('images/logo-180.png') }}">
    {{ vite_entry_link_tags('app') }}
    {{ vite_entry_script_tags('app') }}

    {# hreflang: one entry per language the page is published in. With one
       active language this is a single self-referencing pair, which is still
       what a crawler expects to find. #}
    {% set alternates = locale_alternates() %}
    {% if published_locales is defined %}
        {% set alternates = alternates|filter(a => a.locale.value in published_locales) %}
    {% endif %}
    {% for alternate in alternates %}
        <link rel="alternate" hreflang="{{ alternate.locale.value }}" href="{{ alternate.absolute_url }}">
        {%- if alternate.locale.value == constant('App\\Enum\\Locale::DEFAULT').value %}
            <link rel="alternate" hreflang="x-default" href="{{ alternate.absolute_url }}">
        {%- endif %}
    {% endfor %}

    {# The route-generated URL, not app.request.uri: the events list is reachable
       with filters and a page number on it, and every one of those is the same
       document as far as a search engine should be concerned. #}
    {% set current_alternate = alternates|filter(a => a.current)|first|default(null) %}
    {% set canonical_url = current_alternate ? current_alternate.absolute_url : app.request.uri %}
    <link rel="canonical" href="{{ canonical_url }}">

    {# Open Graph. The site spreads by one dancer pasting a link into a group
       chat, and an untagged URL renders as bare grey text. #}
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ meta_title }}">
    <meta property="og:description" content="{{ meta_desc }}">
    <meta property="og:url" content="{{ canonical_url }}">
    {% if current_alternate %}
        <meta property="og:locale" content="{{ current_alternate.locale.openGraphLocale() }}">
    {% endif %}
    {% block og_image %}
        <meta property="og:image" content="{{ absolute_url(asset('images/og.png')) }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="{{ 'meta.og_image_alt'|trans }}">
        <meta name="twitter:image" content="{{ absolute_url(asset('images/og.png')) }}">
    {% endblock %}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ meta_title }}">
    <meta name="twitter:description" content="{{ meta_desc }}">

    {% block og_meta %}{% endblock %}
    {% block structured_data %}{% endblock %}
    {% block head_links %}{% endblock %}
</head>
<body class="h-full bg-neutral-secondary-soft text-body font-sans antialiased">

{% block navbar %}
    <header class="border-b border-default bg-white">
        <nav class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-2 md:h-14 md:flex-nowrap md:py-0">
            <a href="{{ path('app_home') }}"
               class="flex items-center gap-2 text-lg font-bold tracking-tight text-primary">
                <img src="{{ asset('images/logo.svg') }}" alt="" width="44" height="44" class="h-11 w-11">
                {{ site.name }}
            </a>

            <div class="flex items-center gap-2 md:order-1 md:ml-auto">
                <button type="button"
                        data-collapse-toggle="nav-menu"
                        aria-controls="nav-menu"
                        aria-expanded="false"
                        class="inline-flex items-center rounded-base p-2 text-body hover:bg-neutral-secondary-medium md:hidden">
                    <span class="sr-only">{{ 'nav.menu'|trans }}</span>
                    {{ ux_icon('tabler:menu-2', { style: 'height: 1.5rem; width: 1.5rem;' }) }}
                </button>
            </div>

            <div id="nav-menu" class="hidden w-full md:order-2 md:block md:w-auto">
                <div class="flex flex-col gap-1 border-t border-default pt-3 pb-1 md:flex-row md:items-center md:gap-2 md:border-0 md:p-0">
                    {% block nav_actions %}
                        {# Two destinations, not six. Socials sit under Events
                           as a tab on that page, and Guides live in the footer
                           and the hero: the bar is for where people go weekly. #}
                        <a href="{{ path('app_events') }}" class="{{ nav_link_class }}">{{ 'nav.events'|trans }}</a>
                        <a href="{{ path('app_cities') }}" class="{{ nav_link_class }}">{{ 'nav.cities'|trans }}</a>

                        {# FULLY, never app.user: there is no remember-me cookie
                           and every signed-in page demands FULLY, so anything
                           weaker would offer links that bounce. #}
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <a href="{{ path('app_account') }}" class="{{ nav_link_class }}">{{ 'nav.account'|trans }}</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin') }}" class="{{ nav_link_class }}">{{ 'nav.admin'|trans }}</a>
                            {% endif %}
                            <a href="{{ path('app_logout') }}" class="{{ nav_link_class }}">{{ 'nav.logout'|trans }}</a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="{{ nav_link_class }}">{{ 'nav.login'|trans }}</a>
                        {% endif %}
                        <a href="{{ path('app_submit') }}" class="{{ nav_cta_class }}">{{ 'nav.submit'|trans }}</a>
                    {% endblock %}
                </div>
            </div>
        </nav>
    </header>
{% endblock %}

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="mx-auto max-w-7xl px-4 pt-4">
            <div class="rounded-base px-4 py-3 text-sm
                        {{ label == 'success' ? 'bg-success-medium text-success-strong'
                         : label == 'error'  ? 'bg-danger-medium text-danger-strong'
                         : 'bg-brand-soft text-brand-strong' }}">
                {{ message }}
            </div>
        </div>
    {% endfor %}
{% endfor %}

<main>{% block body %}{% endblock %}</main>

{% block footer %}
    <footer class="mt-16 border-t border-default bg-white">
        <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-10 sm:flex-row sm:justify-between">
            <div class="max-w-sm text-sm text-body-subtle">
                <div class="flex items-center gap-2">
                    <img src="{{ asset('images/logo.svg') }}" alt="" width="24" height="24" class="h-6 w-6 shrink-0">
                    <span class="font-semibold text-heading">{{ site.name }}</span>
                </div>
                <p class="mt-3 leading-relaxed">{{ 'footer.blurb'|trans }}</p>
                <p class="mt-3">
                    <a href="mailto:{{ site.email }}" class="hover:text-body hover:underline">{{ site.email }}</a>
                    {% if site.instagram %}
                        · <a href="{{ site.instagram }}" rel="me noopener" class="hover:text-body hover:underline">Instagram</a>
                    {% endif %}
                </p>
            </div>

            <nav class="text-sm" aria-label="{{ 'footer.links'|trans }}">
                <ul class="grid grid-cols-2 gap-x-8 gap-y-2">
                    {% set links = [
                        { path: path('app_events'), label: 'nav.events' },
                        { path: path('app_socials'), label: 'nav.socials' },
                        { path: path('app_cities'), label: 'nav.cities' },
                        { path: path('app_articles'), label: 'nav.guides' },
                        { path: path('app_submit'), label: 'nav.submit' },
                        { path: path('app_newsletter'), label: 'nav.newsletter' },
                        { path: path('app_about'), label: 'nav.about' },
                        { path: path('app_terms'), label: 'footer.terms' },
                        { path: path('app_privacy'), label: 'footer.privacy' },
                    ] %}
                    {% for link in links %}
                        <li>
                            <a href="{{ link.path }}" class="text-body-subtle hover:text-body hover:underline">
                                {{ link.label|trans }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        </div>
    </footer>
{% endblock %}

</body>
</html>
