{# templates/bundles/TwigBundle/Exception/error.html.twig #}
{% extends 'base.html.twig' %}

{% block navbar %}
{% endblock %}

{% block footer %}
{% endblock %}

{% block body %}
    <div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-lg text-center">
            <div class="flex justify-center text-primary mb-4">
                {{ ux_icon('tabler:alert-triangle', {width: 72, height: 72}) }}
            </div>
            <p class="text-xl font-semibold text-gray-700 mb-8">{{ 'something-went-wrong'|trans }}</p>
            <a href="{{ path('app_home') }}"
               class="inline-flex items-center gap-2 bg-primary hover:bg-primary-hover text-white font-semibold rounded-full px-6 py-3 no-underline transition-colors">
                {{ ux_icon('tabler:arrow-left', {width: 18, height: 18}) }}
                {{ 'back-to-home'|trans }}
            </a>
        </div>
    </div>
{% endblock %}
