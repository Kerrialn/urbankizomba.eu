{% extends 'base.html.twig' %}

{% block title %}{{ 'city.meta_title'|trans({ city: city.name }) }} · {{ site.name }}{% endblock %}
{% block meta_description %}{{ 'city.meta_description'|trans({ city: city.name, country: city.countryName, socials: socials|length, upcoming: upcoming|length }) }}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-5xl px-4 py-10">
        <nav class="text-sm">
            <a href="{{ path('app_cities') }}" class="text-primary hover:underline">&larr; {{ 'nav.cities'|trans }}</a>
        </nav>
        <p class="mt-6 text-sm font-semibold uppercase tracking-widest text-primary">{{ city.countryName }}</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-heading sm:text-4xl">{{ 'city.heading'|trans({ city: city.name }) }}</h1>
        <p class="mt-3 text-body">{{ 'city.intro'|trans({ city: city.name }) }}</p>

        <section class="mt-10">
            <h2 class="text-xl font-bold text-heading">{{ 'city.socials.heading'|trans }}</h2>
            {% if socials is empty %}
                <p class="mt-3 text-sm text-body-subtle">
                    {{ 'city.socials.empty'|trans }}
                    <a href="{{ path('app_submit') }}" class="text-primary hover:underline">{{ 'city.socials.add'|trans }}</a>
                </p>
            {% else %}
                <div class="mt-4 facet facet-frame px-5">
                    <ul class="divide-y divide-default">
                        {% for social in socials %}
                            {{ include('event/_social_row.html.twig', { social: social, confirmation_days: confirmation_days }) }}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </section>

        <section class="mt-12">
            <h2 class="text-xl font-bold text-heading">{{ 'city.upcoming.heading'|trans }}</h2>
            {% if upcoming is empty %}
                <p class="mt-3 text-sm text-body-subtle">
                    {{ 'city.upcoming.empty'|trans }}
                    <a href="{{ path('app_submit') }}" class="text-primary hover:underline">{{ 'city.upcoming.add'|trans }}</a>
                </p>
            {% else %}
                <div class="facet-vary mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    {% for event in upcoming %}
                        {{ include('event/_card.html.twig', { event: event }) }}
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
