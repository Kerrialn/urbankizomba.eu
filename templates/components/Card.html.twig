{# @block content The card content, typically includes `Card:Content` with `Card:Header`, and/or `Card:Footer` #}
<div
    class="{{ ('facet facet-frame facet-fill-neutral-primary-soft text-body block p-6 ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</div>
