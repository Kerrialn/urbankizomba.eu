{# The wordmark, as text: most clients block remote images by default, and the
   name itself always renders. #}
<tr>
    <td style="padding:0 8px 16px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:20px; font-weight:700; letter-spacing:-0.01em; color:#6d28d9;">
        {{ site.name }}
    </td>
</tr>
