{% extends 'email/_layout.html.twig' %}

{% block subject %}{{ 'email.login_code.subject'|trans({ code: code }, locale: locale) }}{% endblock %}

{% block content %}
    <p style="margin:0 0 24px;">{{ 'email.login_code.greeting'|trans({}, locale: locale) }}</p>

    {# The code is the one thing the reader is here for, and it is typed by
       hand: wide letter spacing, and text rather than an image so it can be
       copied. #}
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
        <tr>
            <td align="center"
                style="background-color:#f5f3ff; border:1px solid #ede9fe; border-radius:6px; padding:20px 12px; font-size:32px; font-weight:700; letter-spacing:0.25em; color:#4c1d95;">
                {{ code }}
            </td>
        </tr>
    </table>

    <p style="margin:24px 0 0; font-size:15px;">{{ 'email.login_code.ttl'|trans({ minutes: ttl_minutes }, locale: locale) }}</p>
    <p style="margin:12px 0 0; font-size:13px; color:#6b7280;">{{ 'email.login_code.ignore'|trans({}, locale: locale) }}</p>
{% endblock %}
