{% extends 'email/_layout.html.twig' %}

{% set unsubscribe_url = url('app_newsletter_unsubscribe', { token: subscriber.token }) %}

{% block subject %}{{ 'email.newsletter.subject'|trans({ month: from|format_date(pattern: 'MMMM yyyy') }, locale: locale) }}{% endblock %}

{% block content %}
    <p style="margin:0 0 8px; font-size:13px; text-transform:uppercase; letter-spacing:0.1em; color:#4c1d95; font-weight:600;">
        {{ 'email.newsletter.kicker'|trans({}, locale: locale) }}
    </p>
    <h1 style="margin:0 0 16px; font-size:22px; color:#111827;">
        {{ 'email.newsletter.heading'|trans({ from: from|format_date(pattern: 'd MMM'), to: to|format_date(pattern: 'd MMM yyyy') }, locale: locale) }}
    </h1>
    <p style="margin:0 0 24px;">{{ 'email.newsletter.intro'|trans({ count: events|length }, locale: locale) }}</p>

    {% set current_month = null %}
    {% for event in events %}
        {% set month = event.startsAt|format_date(pattern: 'MMMM yyyy') %}
        {% if month != current_month %}
            {% set current_month = month %}
            <p style="margin:24px 0 8px; font-size:13px; text-transform:uppercase; letter-spacing:0.1em; color:#6b7280; font-weight:600;">{{ month }}</p>
        {% endif %}
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse; margin-bottom:12px;">
            <tr>
                <td style="border:1px solid #e6e3ee; border-radius:6px; padding:12px 16px;">
                    <span style="font-size:13px; color:#4c1d95; font-weight:600;">
                        {{ event.startsAt|format_date(pattern: 'EEE d MMM') }}{% if event.multiDay %} – {{ event.endsAt|format_date(pattern: 'd MMM') }}{% endif %}
                        · {{ event.type.label|trans({}, locale: locale) }}
                    </span><br>
                    <a href="{{ url('app_event', { slug: event.slug }) }}" style="font-size:16px; font-weight:600; color:#111827; text-decoration:none;">{{ event.title }}</a><br>
                    <span style="font-size:14px; color:#6b7280;">{{ event.city.name }}, {{ event.city.countryName }}</span>
                </td>
            </tr>
        </table>
    {% endfor %}

    <p style="margin:24px 0 0; font-size:14px;">
        <a href="{{ url('app_events') }}" style="color:#4c1d95;">{{ 'email.newsletter.all'|trans({}, locale: locale) }}</a>
        ·
        <a href="{{ url('app_submit') }}" style="color:#4c1d95;">{{ 'email.newsletter.submit'|trans({}, locale: locale) }}</a>
    </p>
{% endblock %}
