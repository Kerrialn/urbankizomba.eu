{% extends 'email/_layout.html.twig' %}

{% block subject %}{{ 'email.newsletter_confirm.subject'|trans({}, locale: locale) }}{% endblock %}

{% block content %}
    {% if already_confirmed %}
        <p style="margin:0 0 16px;">{{ 'email.newsletter_confirm.already'|trans({}, locale: locale) }}</p>
        <p style="margin:0; font-size:13px; color:#6b7280;">
            <a href="{{ url('app_newsletter_unsubscribe', { token: subscriber.token }) }}" style="color:#4c1d95;">{{ 'email.unsubscribe'|trans({}, locale: locale) }}</a>
        </p>
    {% else %}
        <p style="margin:0 0 24px;">{{ 'email.newsletter_confirm.body'|trans({}, locale: locale) }}</p>

        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
            <tr>
                <td style="background-color:#4c1d95; border-radius:6px;">
                    <a href="{{ url('app_newsletter_confirm', { token: subscriber.token }) }}"
                       style="display:inline-block; padding:12px 24px; font-weight:600; color:#ffffff; text-decoration:none;">
                        {{ 'email.newsletter_confirm.button'|trans({}, locale: locale) }}
                    </a>
                </td>
            </tr>
        </table>

        <p style="margin:24px 0 0; font-size:13px; color:#6b7280;">{{ 'email.newsletter_confirm.ignore'|trans({}, locale: locale) }}</p>
    {% endif %}
{% endblock %}
