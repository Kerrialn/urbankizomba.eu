{% extends 'base.html.twig' %}

{% set city = event.city %}
{% set when %}
    {%- if event.startsAt -%}
        {{ event.startsAt|format_date(pattern: 'd MMM yyyy') }}{% if event.multiDay %} – {{ event.endsAt|format_date(pattern: 'd MMM yyyy') }}{% endif %}
    {%- elseif event.schedule -%}
        {{ event.schedule }}
    {%- endif -%}
{% endset %}

{% block title %}{{ event.title }} · {{ city.name }} · {{ site.name }}{% endblock %}
{% block meta_description %}{{ 'event.meta_description'|trans({ type: event.type.label|trans, city: city.name, country: city.countryName, when: when|trim }) }}{% endblock %}
{% block og_type %}article{% endblock %}

{% block robots %}
    {% if not event.approved %}
        <meta name="robots" content="noindex">
    {% endif %}
{% endblock %}

{% block og_image %}
    {% if event.poster %}
        {% set poster_url = absolute_url(asset('uploads/posters/' ~ event.poster)) %}
        <meta property="og:image" content="{{ poster_url }}">
        <meta property="og:image:alt" content="{{ event.title }}">
        <meta name="twitter:image" content="{{ poster_url }}">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{# schema.org DanceEvent. Only for dated events: a recurring social has no
   startDate to declare, and an Event without one is ignored anyway. #}
{% block structured_data %}
    {% if event.approved and event.startsAt %}
        {% set data = {
            '@context': 'https://schema.org',
            '@type': event.type.schemaType,
            'name': event.title,
            'description': event.description|slice(0, 300),
            'startDate': event.startsAt|date('Y-m-d'),
            'endDate': event.lastDay|date('Y-m-d'),
            'eventAttendanceMode': 'https://schema.org/OfflineEventAttendanceMode',
            'eventStatus': 'https://schema.org/EventScheduled',
            'url': url('app_event', { slug: event.slug }),
            'location': {
                '@type': 'Place',
                'name': event.venue ?? city.name,
                'address': {
                    '@type': 'PostalAddress',
                    'streetAddress': event.address,
                    'addressLocality': city.name,
                    'addressCountry': city.country,
                },
            },
        } %}
        {% if event.poster %}
            {% set data = data|merge({ image: absolute_url(asset('uploads/posters/' ~ event.poster)) }) %}
        {% endif %}
        {% if event.organiser %}
            {% set data = data|merge({ organizer: { '@type': 'Organization', name: event.organiser, url: event.url } }) %}
        {% endif %}
        {% if event.ticketUrl %}
            {% set data = data|merge({ offers: { '@type': 'Offer', url: event.ticketUrl, availability: 'https://schema.org/InStock' } }) %}
        {% endif %}
        <script type="application/ld+json">
            {{ data|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}
        </script>
    {% endif %}
{% endblock %}

{% block body %}
    <article class="mx-auto max-w-5xl px-4 py-10">
        {% if not event.approved %}
            <div class="mb-6 rounded-base bg-warning-medium px-4 py-3 text-sm text-warning-strong">
                {{ ('event.preview.' ~ event.status.value)|trans }}
                {% if event.reviewNote %}<span class="block mt-1">{{ 'event.preview.note'|trans({ note: event.reviewNote }) }}</span>{% endif %}
            </div>
        {% endif %}

        <nav class="text-sm">
            <a href="{{ event.recurring ? path('app_socials') : path('app_events') }}" class="text-primary hover:underline">
                &larr; {{ (event.recurring ? 'nav.socials' : 'nav.events')|trans }}
            </a>
        </nav>

        <div class="mt-6 grid gap-8 lg:grid-cols-[2fr_1fr]">
            <div>
                <p class="text-sm font-semibold uppercase tracking-widest text-primary">{{ event.type.label|trans }}</p>
                <h1 class="mt-2 text-3xl font-bold tracking-tight text-heading sm:text-4xl">{{ event.title }}</h1>
                <p class="mt-3 text-lg text-body">
                    {{ when }}
                    · <a href="{{ path('app_city', { slug: city.slug }) }}" class="text-primary hover:underline">{{ city.name }}</a>, {{ city.countryName }}
                </p>

                {% if event.recurring %}
                    <p class="mt-2 text-sm {{ event.isStale(confirmation_days) ? 'text-warning' : 'text-body-subtle' }}">
                        {% if event.lastConfirmedAt %}
                            {{ 'social.last_confirmed'|trans({ date: event.lastConfirmedAt|format_date('medium') }) }}
                        {% else %}
                            {{ 'social.unconfirmed'|trans }}
                        {% endif %}
                        {% if event.isStale(confirmation_days) %} · {{ 'social.stale_hint'|trans }}{% endif %}
                    </p>
                {% endif %}

                {% if event.poster %}
                    <img src="{{ asset('uploads/posters/' ~ event.poster) }}" alt=""
                         class="mt-6 w-full rounded-2xl border border-default lg:hidden">
                {% endif %}

                <div class="mt-8 whitespace-pre-line leading-relaxed text-body">{{ event.description }}</div>

                {% if event.lineup %}
                    <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-body-subtle">{{ 'event.lineup'|trans }}</h2>
                    <p class="mt-2 whitespace-pre-line text-body">{{ event.lineup }}</p>
                {% endif %}
            </div>

            <aside class="space-y-4">
                {% if event.poster %}
                    <img src="{{ asset('uploads/posters/' ~ event.poster) }}" alt=""
                         class="hidden w-full rounded-2xl border border-default lg:block">
                {% endif %}

                <div class="rounded-2xl border border-default bg-white p-5 text-sm">
                    <dl class="space-y-3">
                        {% if event.venue or event.address %}
                            <div>
                                <dt class="text-xs font-medium uppercase tracking-wide text-body-subtle">{{ 'event.where'|trans }}</dt>
                                <dd class="mt-0.5 text-heading">
                                    {% if event.venue %}{{ event.venue }}<br>{% endif %}
                                    {% if event.address %}{{ event.address }}<br>{% endif %}
                                    {{ city.name }}, {{ city.countryName }}
                                </dd>
                            </div>
                        {% endif %}
                        {% if event.organiser %}
                            <div>
                                <dt class="text-xs font-medium uppercase tracking-wide text-body-subtle">{{ 'event.organiser'|trans }}</dt>
                                <dd class="mt-0.5 text-heading">{{ event.organiser }}</dd>
                            </div>
                        {% endif %}
                    </dl>

                    {% if event.ticketUrl or event.url %}
                        <div class="mt-5 flex flex-col gap-2">
                            {% if event.ticketUrl %}
                                <a href="{{ event.ticketUrl }}" rel="noopener nofollow" target="_blank"
                                   class="rounded-base bg-primary px-4 py-2.5 text-center font-medium text-white hover:bg-primary-hover">
                                    {{ 'event.tickets'|trans }}
                                </a>
                            {% endif %}
                            {% if event.url %}
                                <a href="{{ event.url }}" rel="noopener nofollow" target="_blank"
                                   class="rounded-base border border-default px-4 py-2.5 text-center font-medium text-body hover:bg-neutral-secondary-medium">
                                    {{ 'event.website'|trans }}
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>

                {% if event.isSubmittedBy(app.user) %}
                    <a href="{{ path('app_account_event_edit', { id: event.id }) }}"
                       class="block rounded-base border border-default bg-white px-4 py-2.5 text-center text-sm font-medium text-body hover:bg-neutral-secondary-medium">
                        {{ 'event.edit_mine'|trans }}
                    </a>
                {% endif %}
            </aside>
        </div>

        {% set others = more|filter(other => other.id != event.id) %}
        {% if others is not empty %}
            <section class="mt-14 border-t border-default pt-8">
                <h2 class="text-xl font-bold text-heading">{{ 'event.more_in_city'|trans({ city: city.name }) }}</h2>
                <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                    {% for other in others|slice(0, 4) %}
                        {{ include('event/_card.html.twig', { event: other }) }}
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </article>
{% endblock %}
