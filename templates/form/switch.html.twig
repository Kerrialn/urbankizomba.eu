{# Renders the actual <input> as a Flowbite-styled toggle switch #}
{% block switch_widget %}
    {# Inject the toggle classes into attr so widget_attributes emits a single, correct class attribute #}
    {% set attr = attr|merge({ class: ('sr-only peer ' ~ attr.class|default(''))|trim }) %}
    <label class="relative inline-flex items-center cursor-pointer">
        <input
                type="checkbox"
                {{ block('widget_attributes') }}   {# name, id, required, class, etc. #}
                role="switch"
                {% if value is defined and value is not same as(false) %}value="{{ value }}"{% endif %}
                {% if checked %}checked="checked"{% endif %}
        />
        <div class="relative w-11 h-6 bg-gray-200 rounded-full
                    peer-focus:ring-4 peer-focus:ring-brand-soft
                    peer-checked:bg-primary
                    after:content-[''] after:absolute after:top-[2px] after:start-[2px]
                    after:bg-white after:border after:border-gray-300 after:rounded-full
                    after:h-5 after:w-5 after:transition-all
                    peer-checked:after:translate-x-full peer-checked:after:border-white
                    rtl:peer-checked:after:-translate-x-full"></div>
    </label>
{% endblock %}

{# Layout: label on the left, switch on the right #}
{% block switch_row %}
    {% set label_text = form.vars.label %}
    {% set help_text = form.vars.help %}
    <div class="flex justify-between items-center w-full p-3 border border-gray-200 rounded-xl bg-white">
        <div class="flex-1">
            {% if label_text is not same as(false) and label_text is not empty %}
                <label class="mb-0 font-medium text-gray-800" for="{{ form.vars.id }}">
                    {{ label_text|trans({}, translation_domain)|capitalize }}
                </label>
            {% endif %}
            {% if help_text is not empty %}
                <div class="text-gray-500 text-sm">{{ help_text|trans({}, translation_domain) }}</div>
            {% endif %}
            {{ form_errors(form) }}
        </div>
        <div class="flex-shrink-0 ml-3">
            {{ form_widget(form) }} {# calls switch_widget above #}
        </div>
    </div>
{% endblock %}
