{% extends 'base.html.twig' %}

{# Shared frame for the legal documents. The chrome is here; the text is in the
   per-language templates that extend this, because a contract is edited as a
   whole document rather than as keyed interface strings. #}
{% block body %}
    <div class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
        <h1 class="text-3xl font-bold tracking-tight text-heading">{% block doc_title %}{% endblock %}</h1>
        <p class="mt-3 text-sm text-body-subtle">{% block doc_subtitle %}{% endblock %}</p>

        {# Prose styling lives here so both documents read identically and neither
           carries a wall of utility classes on every paragraph. #}
        <div class="mt-10 space-y-6 text-body
                    [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-heading
                    [&_h3]:mt-6 [&_h3]:font-semibold [&_h3]:text-heading
                    [&_p]:leading-relaxed
                    [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-6
                    [&_ol]:list-decimal [&_ol]:space-y-1.5 [&_ol]:pl-6
                    [&_a]:text-primary [&_a]:underline
                    [&_table]:w-full [&_table]:text-sm
                    [&_th]:border-b [&_th]:border-default [&_th]:py-2 [&_th]:text-left [&_th]:font-medium
                    [&_td]:border-b [&_td]:border-light [&_td]:py-2 [&_td]:align-top [&_td]:pr-4">
            {% block doc_body %}{% endblock %}
        </div>

        <p class="mt-12 border-t border-default pt-6 text-xs text-body-subtle">
            {% block doc_footer %}{% endblock %}
        </p>
    </div>
{% endblock %}
