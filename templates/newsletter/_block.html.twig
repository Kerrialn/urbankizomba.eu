{# The newsletter pitch and form, as a block for the home page and the
   newsletter page. `form` is a NewsletterSignupFormType view. #}
<div class="facet bg-brand-strong px-6 py-12 text-white sm:px-10">
    <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-2xl font-bold">{{ 'newsletter.heading'|trans }}</h2>
        <p class="mt-3 text-brand-medium">{{ 'newsletter.intro'|trans }}</p>

        {{ form_start(form, { attr: { class: 'mt-6 text-left' } }) }}
            {{ form_errors(form) }}
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
                <div class="flex-1">
                    {{ form_widget(form.email, { attr: {
                        class: 'block w-full rounded-base border-0 px-4 py-3 text-heading placeholder:text-body-subtle focus:ring-2 focus:ring-accent',
                        placeholder: 'newsletter.field.email_placeholder'|trans,
                        'aria-label': 'newsletter.field.email'|trans,
                    } }) }}
                    {{ form_errors(form.email) }}
                </div>
                <button type="submit"
                        class="facet-sm bg-accent px-5 py-3 font-medium text-white hover:bg-pink-700">
                    {{ 'newsletter.submit'|trans }}
                </button>
            </div>
            {{ form_row(form.turnstile) }}
        {{ form_end(form) }}

        <p class="mt-4 text-xs text-brand-medium">{{ 'newsletter.consent'|trans }}</p>
    </div>
</div>
